---
import Layout from "../../../layouts/Layout.astro";
import TrainBoard from "../../../components/trains/TrainBoard";
---

<Layout pageTitle="Departure Board">
  <div class="w-full mx-auto max-w-screen-xl px-5 py-10">
    <div class="mb-2">
      <a
        href="/projects/"
        class="text-sm text-emerald-600 hover:text-emerald-500 transition-colors"
      >
        &larr; Projects
      </a>
    </div>

    <h1 class="font-display text-emerald-500 text-4xl font-bold mb-3">
      Departure Board
    </h1>
    <p class="text-gray-500 mb-10 max-w-2xl">
      Live trains on the North Wales Coast Line at Chester, drawn like the
      dot-matrix boards at UK stations. It's the same 256×64 display as the
      small OLED boards I'm building, using live data from
      <a
        href="https://www.realtimetrains.co.uk"
        class="text-emerald-600 hover:text-emerald-500 transition-colors"
        >Realtime Trains</a
      >.
    </p>

    <TrainBoard client:load />
  </div>
</Layout>
